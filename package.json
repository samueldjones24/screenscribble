{
  "name": "screenscribble",
  "private": true,
  "version": "0.1.0",
  "description": "Transient desktop annotation overlay for demos, meetings, and screenshots.",
  "license": "MIT",
  "author": "ScreenScribble",
  "homepage": "https://screenscribble.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/screenscribble/screenscribble"
  },
  "bugs": {
    "url": "https://github.com/screenscribble/screenscribble/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "dev:frontend": "npm run dev",
    "dev:desktop": "tauri dev",
    "dev:all": "powershell -ExecutionPolicy Bypass -File ./scripts/start-dev.ps1",
    "test": "node --experimental-strip-types --test tests/**/*.test.ts",
    "build": "tsc -b && vite build",
    "build:desktop": "tauri build --bundles nsis && powershell -ExecutionPolicy Bypass -File ./scripts/rename-installer.ps1",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
