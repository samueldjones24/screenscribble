{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScreenScribble",
  "version": "0.1.0",
  "identifier": "com.screenscribble.desktop",
  "build": {
    "beforeDevCommand": "node -e \"process.exit(0)\"",
    "beforeBuildCommand": "npm run build",
    "removeUnusedCommands": true,
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ScreenScribble",
        "width": 980,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "transparent": false,
        "alwaysOnTop": false,
        "decorations": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "center": true
      },
      {
        "label": "overlay",
        "title": "",
        "transparent": true,
        "alwaysOnTop": true,
        "decorations": false,
        "shadow": false,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "publisher": "ScreenScribble",
    "shortDescription": "Transient desktop annotation overlay.",
    "longDescription": "ScreenScribble is a lightweight desktop overlay for temporary annotations during demos, calls, and screenshots.",
    "homepage": "https://screenscribble.app",
    "license": "MIT",
    "copyright": "Copyright (c) 2026 ScreenScribble",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "digestAlgorithm": "sha256",
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "startMenuFolder": "ScreenScribble",
        "installerHooks": "./installer/nsis-hooks.nsh"
      }
    }
  }
}
